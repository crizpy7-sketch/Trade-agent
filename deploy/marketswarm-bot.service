[Unit]
Description=MarketSwarm interactive Discord bot
Documentation=https://github.com/crizpy7-sketch/marketswarm
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=marketswarm
Group=marketswarm
WorkingDirectory=/opt/marketswarm
Environment=PYTHONUNBUFFERED=1
Environment=MARKETSWARM_DATA_DIR=/var/lib/marketswarm
Environment=MARKETSWARM_REPORT_DIR=/var/lib/marketswarm/reports
EnvironmentFile=-/etc/marketswarm/env
ExecStart=/opt/marketswarm/venv/bin/marketswarm --verbose bot
Restart=always
RestartSec=10
TimeoutStopSec=30

# The bot reads the database and public quotes. It writes only sqlite's
# journal, and has no path to publishing or trading. Nothing else is needed.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/marketswarm
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=marketswarm

[Install]
WantedBy=multi-user.target
