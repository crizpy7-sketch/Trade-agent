#!/bin/sh
#
# Run MarketSwarm's CLI exactly as the service runs it.
#
# Two things separate a hand-run CLI from the daemon, and both make `status`
# mislead rather than fail:
#
#   the data directory  The CLI's default is ~/.marketswarm, which for this
#                       system user is an empty directory sitting beside the
#                       real one. `status` then reports a healthy, empty swarm
#                       while the live one is next to it, full of history.
#
#   the credentials     Without /etc/marketswarm/env, every integration reads
#                       "not set" — a configured webhook looks unconfigured,
#                       and the SEC contact shows its own placeholder text.
#
# Both of those are answers about the wrong environment, delivered with the
# same confidence as a right one, which is the worst way for a check to fail.
#
# The env file is sourced into this shell rather than passed as arguments,
# because /proc/<pid>/cmdline is world-readable and the environment is not.
# A token on the command line is a token any local account can read.

set -e

if [ "$(id -u)" -ne 0 ]; then
    echo "marketswarm-cli: run as root (it reads /etc/marketswarm/env)" >&2
    exit 1
fi

set -a
[ -r /etc/marketswarm/env ] && . /etc/marketswarm/env
set +a

# Kept in step with deploy/marketswarm.service — a test fails if they drift.
MARKETSWARM_DATA_DIR=/var/lib/marketswarm
MARKETSWARM_REPORT_DIR=/var/lib/marketswarm/reports
export MARKETSWARM_DATA_DIR MARKETSWARM_REPORT_DIR

exec sudo -E -u marketswarm /opt/marketswarm/venv/bin/marketswarm "$@"
