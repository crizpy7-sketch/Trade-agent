#!/bin/sh
#
# Run MarketSwarm's CLI exactly as the service runs it.
#
# Two things separate a hand-run CLI from the daemon, and both make `status`
# mislead rather than fail: without MARKETSWARM_DATA_DIR the CLI reads its own
# default of ~/.marketswarm — an empty directory beside the real one, so status
# reports a healthy, empty swarm — and without /etc/marketswarm/env every
# integration reads "not set", so a webhook that published this morning shows
# as unconfigured. Both answer confidently about the wrong environment, which is
# the worst way for a check to fail.
#
# Precedence here mirrors marketswarm.service, which sets Environment= before
# EnvironmentFile=: the defaults below are set first so that a value in
# /etc/marketswarm/env overrides them, exactly as it overrides the unit's. Set
# the other way round, relocating the data directory would move the daemon and
# leave this wrapper reporting on the old one.
#
# The env file is sourced into this shell rather than passed as arguments,
# because /proc/<pid>/cmdline is world-readable and the environment is not.
# A token on the command line is a token any local account can read.

set -e

if [ "$(id -u)" -ne 0 ]; then
    echo "marketswarm-cli: run as root (it reads /etc/marketswarm/env)" >&2
    exit 1
fi

# Kept in step with deploy/marketswarm.service — a test fails if they drift.
export MARKETSWARM_DATA_DIR=/var/lib/marketswarm
export MARKETSWARM_REPORT_DIR=/var/lib/marketswarm/reports

set -a
[ -r /etc/marketswarm/env ] && . /etc/marketswarm/env
set +a

# -H gives the service user its own home directory. Without it, sudo -E keeps
# root’s HOME and Config.load() tries to stat /root/.marketswarm/config.yaml,
# which the locked-down service user must not be able to read.
exec sudo -H -E -u marketswarm /opt/marketswarm/venv/bin/marketswarm "$@"
