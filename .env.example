# Copy to .env (docker compose) or /etc/marketswarm/env (systemd).
# Secrets live here only — never in config.yaml, never in the database.

# Required. SEC EDGAR requires a declared contact and throttles anonymous clients.
MARKETSWARM_CONTACT=you@example.com

# Optional. Enables the written narrative and the scoring post-mortem.
ANTHROPIC_API_KEY=

# Optional. Adds authoritative macro series (CPI, payrolls, yields) from FRED.
# Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Optional. Discord/Slack-compatible webhook for the morning summary.
MARKETSWARM_WEBHOOK=

# Schedule in Eastern Time. DST is handled internally.
MARKETSWARM_RUN_TIME=08:15

# Optional overrides.
#MARKETSWARM_UNIVERSE=SPY,QQQ,NVDA,AAPL,MSFT,AMZN,META,TSLA,AMD
#MARKETSWARM_BASE_RISK=0.75
#MARKETSWARM_MODEL=claude-opus-4-5
#MARKETSWARM_LLM_ENABLED=true

# Optional permissioned community research. The Discord bot may read only
# channels it has been invited to and granted View Channel + Read History.
# Use a private intake channel for TradingView alerts or manually forwarded
# TradingView/X idea links. No TradingView scraping and no Discord self-bot.
# The same bot token can power both interactive commands and research intake.
#MARKETSWARM_DISCORD_BOT_TOKEN=
#MARKETSWARM_DISCORD_CHANNEL_ID=123456789012345678
#MARKETSWARM_DISCORD_ALLOWED_USERS=your-user-id
#MARKETSWARM_SOCIAL_DISCORD_CHANNEL_IDS=123456789012345678
#MARKETSWARM_COMMUNITY_LOOKBACK_HOURS=24
#MARKETSWARM_COMMUNITY_MIN_SOURCES=2

# Optional official X API. X currently charges per use; leaving the token empty
# keeps X disabled. Handles are explicit because follower count is not trust.
#MARKETSWARM_X_HANDLES=handle1,handle2
#X_BEARER_TOKEN=
